{
  "name": "deception",
  "version": "0.1.0",
  "private": true,
  "description": "A five-letter word game where the feedback can lie",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": ".venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --port 8000",
    "dev:web": "npm run dev --workspace @deception/frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": ".venv\\Scripts\\python.exe backend/run_tests.py",
    "test:frontend": "npm run test --workspace @deception/frontend",
    "test:e2e": "npm run test:e2e --workspace @deception/frontend",
    "build": "npm run build:frontend && .venv\\Scripts\\python.exe -m compileall -q backend/app",
    "build:frontend": "npm run build --workspace @deception/frontend",
    "lint": "npm run lint --workspace @deception/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
