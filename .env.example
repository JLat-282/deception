# Local defaults work without this file. Copy to .env only to override them.
DECEPTION_DB_PATH=.data/deception.sqlite
DECEPTION_DAILY_SEED=local-development-seed
DECEPTION_ANSWER_LIST_VERSION=wordle-answers-v1
DECEPTION_SECURE_COOKIE=false
DECEPTION_REVERSE_ENTRY_ENABLED=true

# Optional deterministic controls for automated tests only.
# DECEPTION_FIXED_ANSWER=crane
# DECEPTION_FIXED_NOW=2026-07-28T12:00:00Z
# DECEPTION_FIXED_LIE_ROW=1
# DECEPTION_FIXED_LIE_ROWS=1,3
# DECEPTION_FIXED_SESSION_SEED=test-session-seed
# DECEPTION_FIXED_REVERSE_ENTRY_ROLL=0.05
