# Local defaults work without this file. Copy to .env only to override them.
DECEPTION_DB_PATH=.data/deception.sqlite
# Production uses Postgres when DATABASE_URL is set. Use a transaction-pooler
# URL from Neon, Supabase, or another managed Postgres provider.
# DATABASE_URL=postgresql://user:password@host:6543/database?sslmode=require
DECEPTION_DAILY_SEED=local-development-seed
DECEPTION_ANSWER_LIST_VERSION=wordle-answers-v1
DECEPTION_SECURE_COOKIE=false
DECEPTION_REVERSE_ENTRY_ENABLED=true
DECEPTION_GUESS_TIMER_ENABLED=true
DECEPTION_BLACKOUT_ENABLED=true
# Truthful fallback budget for plausibility search, in milliseconds.
DECEPTION_DECISION_BUDGET_MS=100

# Optional deterministic controls for automated tests only.
# DECEPTION_FIXED_ANSWER=crane
# DECEPTION_FIXED_NOW=2026-07-28T12:00:00Z
# DECEPTION_FIXED_LIE_ROW=1
# DECEPTION_FIXED_LIE_ROWS=1,3
# DECEPTION_FIXED_SESSION_SEED=test-session-seed
# DECEPTION_FIXED_REVERSE_ENTRY_ROLL=0.05
# DECEPTION_FIXED_TIMER_ROLL=0.10
# DECEPTION_FIXED_TIMER_DURATION=10
# DECEPTION_FIXED_TIMER_ATTEMPT=3
# DECEPTION_FIXED_BLACKOUT_ROLL=0.05
# DECEPTION_FIXED_BLACKOUT_ATTEMPT=4
